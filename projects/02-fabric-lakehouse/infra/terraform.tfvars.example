# Use a non-production subscription and a new, project-only resource group.
subscription_id     = "00000000-0000-0000-0000-000000000000"
location            = "westeurope"
resource_group_name = "rg-azpg-02-sandbox"

# User Principal Name (UPN) for users (from az ad signed-in-user show --query userPrincipalName),
# or Object UUID for service principals.
principal_object_id = "user@example.com"

# Capacity names must be globally unique across Azure and start with azpg02.
fabric_capacity_name = "azpg02mysandbox"

# Optional workspace and Lakehouse names.
workspace_name = "ws-azpg-02-sandbox"
lakehouse_name = "lh_azpg_02_sandbox"

# Fabric capacities incur hourly compute charges. Suspend when not testing:
# az fabric capacity suspend --resource-group rg-azpg-02-sandbox --capacity-name azpg02mysandbox
# Or run make down from the project directory to destroy all resources.
