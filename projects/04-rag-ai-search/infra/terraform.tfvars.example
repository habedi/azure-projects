# Copy to terraform.tfvars and replace every placeholder before planning.
# Use a non-production subscription and a region supporting Azure OpenAI and AI Search.
# The deployment identity needs resource creation and role assignment permissions.
# Microsoft.Search, Microsoft.CognitiveServices, and Microsoft.Storage must already be registered.
subscription_id      = "REPLACE_WITH_SUBSCRIPTION_UUID"
location             = "REPLACE_WITH_AZURE_REGION"
resource_group_name  = "rg-azpg-04-replace-me"
storage_account_name = "azpg04replaceme"
search_service_name  = "azpg04-replaceme-search"
openai_account_name  = "azpg04-replaceme-openai"
principal_object_id  = "REPLACE_WITH_PRINCIPAL_OBJECT_UUID"

# AI Search and Azure OpenAI incur hourly charges while active. Run make down from
# the experiment directory to remove its resources after use. Do not put unrelated
# resources in this group. Local state and saved plans can contain sensitive data.
